# Dynamic Partitions
ro.boot.dynamic_partitions=true

# Fstab
ro.postinstall.fstab.prefix=/system

# USB MTP
ro.sys.usb.storage.type=mtp
ro.recovery.usb.vid=18D1
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0
ro.recovery.usb.mtp.pid=4EE1
ro.recovery.usb.mtpadb.pid=4EE2

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts
ro.product.device=beryl
fbe.metadata.wrappedkey=true

# TEE
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_mitee_support=1

# Misc
ro.vendor.mediatek.platform=MT6855
